# Copy to keystore.properties (same folder) and fill in. keystore.properties is in .gitignore:
# never commit it. Keep it AND cachew-release.jks safe forever (cloud + USB stick):
# without them no update can be installed over an existing Cachew.
storeFile=cachew-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=cachew
keyPassword=YOUR_KEY_PASSWORD
