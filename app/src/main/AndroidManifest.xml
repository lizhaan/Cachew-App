<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package visibility (Android 11+): lets us list apps that have a home-screen icon,
         for "+ Other app" and the "not installed" check. No QUERY_ALL_PACKAGES needed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cachew">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The 10-second pause on top of a shop. Own task (taskAffinity) so it doesn't pull the
             den along; singleTask so repeated shop events reuse it; hidden from Recents. -->
        <activity
            android:name=".pause.PauseActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="app.cachew.pause"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Cachew.Night"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Notices which app comes to the front (package name only). Only the system can bind to it. -->
        <service
            android:name=".service.ShopWatchService"
            android:exported="false"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shop_watch_service" />
        </service>
    </application>

</manifest>
