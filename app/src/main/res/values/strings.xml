    <string name="permission_title">Let Cachew notice when a shop opens</string>
    <string name="permission_see_title">What we see</string>
    <string name="permission_see_body">That a shopping app was opened, and when.</string>
    <string name="permission_never_title">What we never see</string>
    <string name="permission_never_body">Your card, your bank, your passwords or what\'s in your cart.</string>
    <string name="permission_allow">Allow access</string>
    <string name="permission_continue">Continue</string>
    <string name="permission_is_on">Access is on</string>
    <string name="permission_why">Why we need this</string>
    <string name="permission_why_title">Why Cachew needs this</string>
    <string name="permission_why_body">Android only tells an app which other app is on screen through Accessibility. Cachew uses it for one thing: noticing that a shop you picked was opened, so it can pause you. It never reads the screen, never sees what you type or buy, and nothing leaves your phone.</string>
    <string name="permission_still_off">Almost there: in Accessibility, open “Cachew shop pause” (on Xiaomi: Downloaded apps) and switch it on.</string>
    <string name="permission_restricted_hint">Switch greyed out? Open Settings → Apps → Cachew → ⋮ → Allow restricted settings, then try again.</string>
    <string name="permission_not_now">Not now</string>

    <!-- Xiaomi / Redmi / POCO extra step -->
    <string name="xiaomi_title">One more step on Xiaomi</string>
    <string name="xiaomi_body">In Other permissions, turn on “Display pop-up windows while running in the background”. Without it the pause waits until you open Cachew yourself.</string>
    <string name="xiaomi_open">Open settings</string>
    <string name="xiaomi_done">It\'s on</string>
    <string name="ok">OK</string>

    <!-- Accessibility service (shown in system Settings → Accessibility) -->
    <string name="service_label">Cachew shop pause</string>
    <string name="service_description">Cachew sees only which app was opened, and only to pause you before shopping apps you picked. It does not read the screen, what you type, or what you buy.</string>

